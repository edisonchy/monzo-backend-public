MONZO_DATABASE_URL=postgresql+psycopg://monzo_app:REPLACE@postgres:5432/monzo
MONZO_OWNER_TOKEN=GENERATE_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARS
MONZO_AUTOMATION_TOKEN=GENERATE_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_CHARS
MONZO_ENCRYPTION_KEY=GENERATE_FERNET_KEY
MONZO_WEBHOOK_SECRET=GENERATE_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARS
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8087/oauth/callback
MONZO_PROXY_URL=http://cliproxyapi:8317/v1
MONZO_PROXY_KEY=
MONZO_MODEL=
MONZO_AI_ENABLED=false
MONZO_AI_AUTO_ACCEPT=false
MONZO_SECURE_COOKIES=true
MONZO_WEB_SEARCH_ENABLED=false
MONZO_SEARCH_TIMEOUT=60
MONZO_DASHBOARD_ORIGIN=
MONZO_DASHBOARD_PASSWORD_HASH=

# Production gateway addresses must be pinned before trusting its client header.
MONZO_GATEWAY_FRONTEND_IP=
MONZO_GATEWAY_AUTOMATION_IP=
MONZO_DASHBOARD_TRUSTED_PROXY_IPS=[]
